# --- Supabase (database) ---
# Get these from your Supabase project: Project Settings -> API
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# IMPORTANT: this is the SERVICE ROLE key (secret, server-side only) — not the "anon" public key.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Admin panel login ---
# Choose your own real username/password here. Never commit the real .env.local file.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="choose-a-strong-password"

# --- Gemini AI (optional, only if you use AI features) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
